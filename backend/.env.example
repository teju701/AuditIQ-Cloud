# Backend Environment Configuration
AWS_REGION=us-east-1
S3_BUCKET=auditiq-cloud-datasets-demo
DYNAMODB_DATASETS_TABLE=AuditIQDatasets
DYNAMODB_AUDIT_RUNS_TABLE=AuditIQAuditRuns

COGNITO_USER_POOL_ID=us-east-1_examplepool
COGNITO_APP_CLIENT_ID=exampleappclientid12345
COGNITO_REGION=us-east-1
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_examplepool

BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

AUDITIQ_CACHE_ENABLED=true
AUDITIQ_CACHE_TTL_SECONDS=900
AUDITIQ_CACHE_MAX_SIZE=500
AUDITIQ_ENABLE_DUAL_RUN_CONSENSUS=false

AUDITIQ_PROMPT_MAX_COLUMNS=24
AUDITIQ_PROMPT_MAX_SAMPLE_VALUES=3
AUDITIQ_PROMPT_MAX_TOP_VALUES=5

AUDITIQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUDITIQ_DEV_MODE=true
